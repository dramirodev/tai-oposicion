rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Administrador: solo la cuenta de Google del propietario (correo verificado).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'dramiro@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isOwner(uid) { return isAdmin() && request.auth.uid == uid; }
    // Usuario aprobado por el propietario: existe access/{uid} con ok == true.
    function isApproved(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/access/$(uid))
        && get(/databases/$(database)/documents/access/$(uid)).data.ok == true;
    }
    // Pueden leer y escribir sus propios datos el propietario y los aprobados.
    function canUse(uid) { return isOwner(uid) || isApproved(uid); }

    function validScoringPolicy(policy) {
      return policy is map
        && policy.keys().hasOnly(['version', 'correctPoints', 'wrongPenalty', 'blankPoints'])
        && policy.keys().hasAll(['version', 'correctPoints', 'wrongPenalty', 'blankPoints'])
        && policy.version == 1
        && policy.correctPoints is number && policy.correctPoints > 0 && policy.correctPoints <= 100
        && (policy.wrongPenalty == null || (policy.wrongPenalty is number && policy.wrongPenalty >= 0 && policy.wrongPenalty <= 100))
        && policy.blankPoints is number && policy.blankPoints >= 0 && policy.blankPoints <= policy.correctPoints;
    }

    function validAttempt(attemptId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'schemaVersion', 'id', 'sessionId', 'questionId', 'contentRevision', 'mode', 'position',
          'exposure', 'exposureKind', 'retryOfAttemptId', 'state', 'response', 'outcome', 'confidence', 'discardedOptions', 'highlights',
          'createdAt', 'completedAt', 'lastSequence', 'appliedEventIds', 'terminalEventId'
        ])
        && d.schemaVersion == 1
        && d.id == attemptId
        && d.sessionId is string && d.sessionId.size() > 0 && d.sessionId.size() <= 128
        && d.questionId is string && d.questionId.size() > 0 && d.questionId.size() <= 128
        && d.contentRevision is string && d.contentRevision.size() <= 128
        && d.mode in ['practice', 'simulation']
        && d.position is int && d.position >= 0
        && d.exposure is int && d.exposure >= 1
        && (!('exposureKind' in d) || d.exposureKind in ['ordinary', 'immediate-retry'])
        && (!('retryOfAttemptId' in d) || (d.retryOfAttemptId is string && d.retryOfAttemptId.size() > 0 && d.retryOfAttemptId.size() <= 128 && d.retryOfAttemptId != d.id))
        && (('exposureKind' in d && d.exposureKind == 'immediate-retry') ? 'retryOfAttemptId' in d : !('retryOfAttemptId' in d))
        && d.state in ['unseen', 'pending', 'answered', 'revealed']
        && (d.response == null || (d.response is int && d.response >= 0 && d.response <= 10))
        && (d.outcome == null || d.outcome in ['correct', 'wrong'])
        && (!('terminalEventId' in d) || (d.terminalEventId is string && d.terminalEventId.size() <= 128))
        && d.confidence in [null, 'sure', 'betweenTwo', 'guess']
        && d.discardedOptions is list && d.discardedOptions.size() <= 10
        && d.highlights is list
        && d.createdAt is number
        && (!('completedAt' in d) || d.completedAt is number)
        && d.lastSequence is int && d.lastSequence >= 0
        && d.appliedEventIds is list && d.appliedEventIds.size() <= 256;
    }

    function validHighlight(h) {
      return h is map
        && h.keys().hasOnly([
          'id', 'field', 'start', 'end', 'text', 'before', 'after', 'category',
          'contentRevision', 'createdAt', 'timing', 'stale'
        ])
        && h.id is string && h.id.size() <= 128
        && (h.field == 'statement' || h.field.matches('option:[0-9]+'))
        && h.start is int && h.start >= 0 && h.end is int && h.end > h.start
        && h.text is string && h.text.size() <= 2000
        && h.before is string && h.before.size() <= 256
        && h.after is string && h.after.size() <= 256
        && h.category in ['key', 'doubt']
        && h.contentRevision is string && h.contentRevision.size() <= 128
        && h.createdAt is number
        && h.timing in ['before-answer', 'after-answer', 'after-reveal']
        && (!('stale' in h) || h.stale is bool);
    }

    function validAttemptSession(sessionId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion', 'id', 'sourceSessionId', 'mode', 'status', 'startedAt', 'timeLimitSeconds', 'elapsedSeconds', 'endedAt', 'lastSequence'])
        && d.schemaVersion == 1
        && d.id == sessionId
        && (!('sourceSessionId' in d) || (d.sourceSessionId is string && d.sourceSessionId.size() <= 128))
        && d.mode in ['practice', 'simulation']
        && d.status in ['active', 'completed', 'interrupted']
        && d.startedAt is number
        && (!('timeLimitSeconds' in d) || (d.timeLimitSeconds is number && d.timeLimitSeconds > 0))
        && (!('elapsedSeconds' in d) || (d.elapsedSeconds is number && d.elapsedSeconds >= 0))
        && (!('endedAt' in d) || d.endedAt is number)
        && (d.status == 'active' ? !('endedAt' in d) : 'endedAt' in d)
        && d.lastSequence is int && d.lastSequence >= 0;
    }

    function validTrainingStep(step) {
      return step is map
        && step.keys().hasOnly(['id', 'activity', 'minutes', 'reason', 'topicId', 'topicIds', 'reviewMode', 'attemptSessionIds', 'sectionRecall'])
        && step.keys().hasAll(['activity', 'minutes', 'reason'])
        && step.activity in ['newContent', 'activeRecall', 'topicTest', 'mixedTopicTest', 'failures', 'spacedReviews']
        && step.minutes is int && step.minutes >= 1 && step.minutes <= 240
        && step.reason in ['active-recall', 'new-content-day', 'new-topic-day', 'weak-topics', 'coverage', 'recurring-failures', 'due-reviews']
        && (!('topicId' in step) || (step.topicId is string && step.topicId.matches('T[0-9]+\\.[0-9]{2}')))
        && (!('topicIds' in step) || (step.topicIds is list && step.topicIds.size() <= 500))
        && (!('reviewMode' in step) || step.reviewMode in ['initial-study', 'active-retrieval', 'selective-reading', 'broad-reading'])
        && (!('id' in step) || (step.id is string && step.id.size() <= 180))
        && (!('attemptSessionIds' in step) || (step.attemptSessionIds is list && step.attemptSessionIds.size() <= 500))
        && (!('sectionRecall' in step) || validSectionRecallStep(step.sectionRecall));
    }

    function validSectionRecallStep(recall) {
      return recall is map
        && recall.keys().hasOnly(['agendaItemId', 'followUpId', 'sectionId', 'materialPath', 'sourceHash', 'outlineFingerprint', 'sectionTitle', 'printedPage'])
        && recall.keys().hasAll(['agendaItemId', 'followUpId', 'sectionId', 'materialPath', 'sourceHash', 'outlineFingerprint'])
        && recall.agendaItemId is string && recall.agendaItemId.size() >= 1 && recall.agendaItemId.size() <= 128
        && recall.followUpId is string && recall.followUpId.matches('[a-zA-Z0-9_-]{8,128}')
        && recall.sectionId is string && recall.sectionId.matches('ci-[a-fA-F0-9]{20}')
        && recall.materialPath is string && recall.materialPath.size() >= 1 && recall.materialPath.size() <= 500
        && recall.sourceHash is string && recall.sourceHash.matches('[a-fA-F0-9]{64}')
        && recall.outlineFingerprint is string && recall.outlineFingerprint.matches('[a-fA-F0-9]{64}')
        && (!('sectionTitle' in recall) || (recall.sectionTitle is string && recall.sectionTitle.size() <= 500))
        && (!('printedPage' in recall) || (recall.printedPage is int && recall.printedPage >= 0));
    }

    function validTrainingHistory(history) {
      // The owner can only write their own data. The client validates each history entry;
      // rules bound the aggregate to keep the configuration document small.
      return history is list && history.size() <= 30;
    }

    function validTrainingSession() {
      let d = request.resource.data;
      let s = d.session;
      return d.keys().hasOnly(['schemaVersion', 'updatedAt', 'session', 'history'])
        && d.keys().hasAll(['schemaVersion', 'updatedAt', 'session'])
        && (d.schemaVersion == 1 ? !('history' in d) : d.schemaVersion == 2 && 'history' in d && validTrainingHistory(d.history))
        && d.updatedAt is number
        && s is map
        && s.keys().hasOnly(['schemaVersion', 'id', 'dateKey', 'activities', 'currentIndex', 'currentStartedAt', 'breakStartedAt', 'breakDurationMinutes', 'elapsedSecondsByActivity', 'updatedAt', 'startedAt', 'completedAt'])
        && s.keys().hasAll(['dateKey', 'activities', 'currentIndex', 'currentStartedAt', 'startedAt', 'completedAt'])
        && s.dateKey is string && s.dateKey.matches('20[0-9]{2}-[0-9]{2}-[0-9]{2}')
        && (!('schemaVersion' in s) || s.schemaVersion == 2)
        && (!('id' in s) || (s.id is string && s.id.size() <= 180))
        && s.activities is list && s.activities.size() >= 1 && s.activities.size() <= 12
        && s.activities[0] is map && validTrainingStep(s.activities[0])
        && (s.activities.size() < 2 || validTrainingStep(s.activities[1]))
        && (s.activities.size() < 3 || validTrainingStep(s.activities[2]))
        && (s.activities.size() < 4 || validTrainingStep(s.activities[3]))
        && (s.activities.size() < 5 || validTrainingStep(s.activities[4]))
        && (s.activities.size() < 6 || validTrainingStep(s.activities[5]))
        && (s.activities.size() < 7 || validTrainingStep(s.activities[6]))
        && (s.activities.size() < 8 || validTrainingStep(s.activities[7]))
        && (s.activities.size() < 9 || validTrainingStep(s.activities[8]))
        && (s.activities.size() < 10 || validTrainingStep(s.activities[9]))
        && (s.activities.size() < 11 || validTrainingStep(s.activities[10]))
        && (s.activities.size() < 12 || validTrainingStep(s.activities[11]))
        && s.currentIndex is int && s.currentIndex >= 0 && s.currentIndex <= s.activities.size()
        && (s.currentStartedAt == null || s.currentStartedAt is number)
        && (!('breakStartedAt' in s) || s.breakStartedAt == null || s.breakStartedAt is number)
        && (!('breakDurationMinutes' in s) || (s.breakDurationMinutes is int && s.breakDurationMinutes >= 3 && s.breakDurationMinutes <= 15))
        && (!('elapsedSecondsByActivity' in s) || (s.elapsedSecondsByActivity is list
          && s.elapsedSecondsByActivity.size() == s.activities.size()
          && s.elapsedSecondsByActivity.size() <= 12
          && s.elapsedSecondsByActivity[0] is int && s.elapsedSecondsByActivity[0] >= 0 && s.elapsedSecondsByActivity[0] <= 86400
          && (s.elapsedSecondsByActivity.size() < 2 || (s.elapsedSecondsByActivity[1] is int && s.elapsedSecondsByActivity[1] >= 0 && s.elapsedSecondsByActivity[1] <= 86400))
          && (s.elapsedSecondsByActivity.size() < 3 || (s.elapsedSecondsByActivity[2] is int && s.elapsedSecondsByActivity[2] >= 0 && s.elapsedSecondsByActivity[2] <= 86400))
          && (s.elapsedSecondsByActivity.size() < 4 || (s.elapsedSecondsByActivity[3] is int && s.elapsedSecondsByActivity[3] >= 0 && s.elapsedSecondsByActivity[3] <= 86400))
          && (s.elapsedSecondsByActivity.size() < 5 || (s.elapsedSecondsByActivity[4] is int && s.elapsedSecondsByActivity[4] >= 0 && s.elapsedSecondsByActivity[4] <= 86400))
          && (s.elapsedSecondsByActivity.size() < 6 || (s.elapsedSecondsByActivity[5] is int && s.elapsedSecondsByActivity[5] >= 0 && s.elapsedSecondsByActivity[5] <= 86400))
          && (s.elapsedSecondsByActivity.size() < 7 || (s.elapsedSecondsByActivity[6] is int && s.elapsedSecondsByActivity[6] >= 0 && s.elapsedSecondsByActivity[6] <= 86400))
          && (s.elapsedSecondsByActivity.size() < 8 || (s.elapsedSecondsByActivity[7] is int && s.elapsedSecondsByActivity[7] >= 0 && s.elapsedSecondsByActivity[7] <= 86400))
          && (s.elapsedSecondsByActivity.size() < 9 || (s.elapsedSecondsByActivity[8] is int && s.elapsedSecondsByActivity[8] >= 0 && s.elapsedSecondsByActivity[8] <= 86400))
          && (s.elapsedSecondsByActivity.size() < 10 || (s.elapsedSecondsByActivity[9] is int && s.elapsedSecondsByActivity[9] >= 0 && s.elapsedSecondsByActivity[9] <= 86400))
          && (s.elapsedSecondsByActivity.size() < 11 || (s.elapsedSecondsByActivity[10] is int && s.elapsedSecondsByActivity[10] >= 0 && s.elapsedSecondsByActivity[10] <= 86400))
          && (s.elapsedSecondsByActivity.size() < 12 || (s.elapsedSecondsByActivity[11] is int && s.elapsedSecondsByActivity[11] >= 0 && s.elapsedSecondsByActivity[11] <= 86400))))
        && (!('updatedAt' in s) || s.updatedAt is number)
        && s.startedAt is number
        && (s.completedAt == null || s.completedAt is number)
        && (s.completedAt == null || s.currentIndex == s.activities.size())
        && (s.currentIndex < s.activities.size() || s.completedAt != null);
    }

    function validTrainingCalendar() {
      let d = request.resource.data;
      // The app validates each activity before saving. Rules bound the private document and its fields.
      return d.keys().hasOnly(['schemaVersion', 'updatedAt', 'activities'])
        && d.keys().hasAll(['schemaVersion', 'updatedAt', 'activities'])
        && d.schemaVersion == 1
        && d.updatedAt is number
        && d.activities is list && d.activities.size() <= 90;
    }

    function validWeeklyStudyAgenda(agenda) {
      return agenda is map
        && agenda.keys().hasOnly(['schemaVersion', 'revision', 'updatedAt', 'items'])
        && agenda.keys().hasAll(['schemaVersion', 'revision', 'updatedAt', 'items'])
        && agenda.schemaVersion == 1
        && agenda.revision is int && agenda.revision >= 0
        && agenda.updatedAt is number && agenda.updatedAt >= 0
        && agenda.items is list && agenda.items.size() <= 70;
    }

    function validAcademyMaterialSelection(topicId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['topicId', 'materials', 'revision', 'updatedAt'])
        && d.keys().hasAll(['topicId', 'materials', 'revision', 'updatedAt'])
        && d.topicId == topicId && topicId.matches('^T[0-9]+\\.[0-9]{2}$')
        && d.materials is list && d.materials.size() <= 30
        && d.revision is int && d.revision >= 1
        && d.updatedAt is number && d.updatedAt >= 0;
    }

    function validAcademySectionEvent(eventId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'topicId', 'sectionId', 'materialPath', 'sourceHash', 'outlineFingerprint', 'kind', 'coverage', 'timing', 'rating', 'followUpId', 'sourceSelfCheckEventId', 'dueDateKey', 'status', 'sectionTitle', 'printedPage', 'occurredAt', 'trainingSessionId', 'trainingActivityId'])
        && d.keys().hasAll(['id', 'topicId', 'sectionId', 'materialPath', 'sourceHash', 'outlineFingerprint', 'kind', 'occurredAt'])
        && d.id == eventId && eventId.matches('^[A-Za-z0-9_-]{8,128}$')
        && d.topicId.matches('^T[0-9]+\\.[0-9]{2}$')
        && d.sectionId.matches('^ci-[a-fA-F0-9]{20}$')
        && d.materialPath is string && d.materialPath.size() > 0 && d.materialPath.size() <= 500
        && d.sourceHash.matches('^[a-fA-F0-9]{64}$')
        && d.outlineFingerprint.matches('^[a-fA-F0-9]{64}$')
        && d.occurredAt is number && d.occurredAt >= 0
        && (!('trainingSessionId' in d) || (d.trainingSessionId is string && d.trainingSessionId.size() <= 128))
        && (!('trainingActivityId' in d) || (d.trainingActivityId is string && d.trainingActivityId.size() <= 128))
        && (d.kind == 'coverage'
          ? d.coverage in ['not-started', 'partial', 'covered'] && !('timing' in d) && !('rating' in d)
          : d.kind == 'self-check'
            ? d.timing in ['assisted', 'immediate', 'delayed'] && d.rating in ['not-recalled', 'partial', 'recalled'] && !('coverage' in d)
            : d.kind == 'follow-up'
              ? d.followUpId.matches('^[A-Za-z0-9_-]{8,128}$') && d.sourceSelfCheckEventId.matches('^[A-Za-z0-9_-]{8,128}$')
                && d.dueDateKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') && d.status in ['scheduled', 'completed', 'cancelled']
                && (!('sectionTitle' in d) || (d.sectionTitle is string && d.sectionTitle.size() <= 500))
                && (!('printedPage' in d) || (d.printedPage is int && d.printedPage >= 0))
                && !('coverage' in d) && !('timing' in d) && !('rating' in d)
              : false);
    }

    function validAttemptEvent(eventId, attemptId) {
      let d = request.resource.data;
      let p = d.payload;
      return d.keys().hasOnly(['schemaVersion', 'id', 'attemptId', 'sequence', 'type', 'at', 'monotonicAt', 'payload'])
        && d.schemaVersion == 1
        && d.id == eventId && d.attemptId == attemptId
        && d.sequence is int && d.sequence > 0
        && d.at is number
        && (!('monotonicAt' in d) || d.monotonicAt is number)
        && p is map
        && (d.type in ['open', 'leave', 'mark-pending', 'reveal', 'pause', 'resume', 'close']
          ? p.keys().size() == 0
          : d.type == 'answer'
            ? p.keys().hasOnly(['optionIndex', 'outcome']) && p.optionIndex is int && p.optionIndex >= 0 && p.outcome in ['correct', 'wrong']
            : d.type == 'set-confidence'
              ? p.keys().hasOnly(['value']) && p.value in ['sure', 'betweenTwo', 'guess']
              : d.type in ['discard-option', 'restore-option']
                ? p.keys().hasOnly(['optionIndex']) && p.optionIndex is int && p.optionIndex >= 0
                : d.type == 'add-highlight'
                  ? p.keys().hasOnly(['highlight']) && validHighlight(p.highlight)
                  : d.type == 'remove-highlight'
                    ? p.keys().hasOnly(['highlightId']) && p.highlightId is string
                    : false);
    }

    function terminalEventIsValid(attemptId) {
      let d = request.resource.data;
      let eventPath = /databases/$(database)/documents/users/$(request.auth.uid)/attempts/$(attemptId)/events/$(d.terminalEventId);
      return 'terminalEventId' in d
        && exists(eventPath)
        && get(eventPath).data.id == d.terminalEventId
        && get(eventPath).data.attemptId == attemptId
        && (d.state == 'revealed'
          ? get(eventPath).data.type == 'reveal' && d.response == null && d.outcome == null
          : d.state == 'answered'
            && get(eventPath).data.type == 'answer'
            && get(eventPath).data.payload.optionIndex == d.response
            && get(eventPath).data.payload.outcome == d.outcome);
    }

    function practiceAnswerIsLocked(attemptId) {
      return resource.data.mode == 'simulation'
        || (resource.data.mode == 'practice'
          && resource.data.state in ['answered', 'revealed']
          && ((request.resource.data.state == resource.data.state
              && request.resource.data.response == resource.data.response
              && request.resource.data.outcome == resource.data.outcome
              && request.resource.data.terminalEventId == resource.data.terminalEventId)
            || (request.resource.data.terminalEventId != resource.data.terminalEventId
              && terminalEventIsValid(attemptId))))
        || (resource.data.mode == 'practice'
          && resource.data.state in ['unseen', 'pending']
          && (request.resource.data.state in ['unseen', 'pending'] || terminalEventIsValid(attemptId)));
    }

    // Banco de preguntas: lo leen el propietario y los aprobados; solo se escribe desde el script de publicación (IAM, no reglas).
    match /bank/{doc} {
      allow read: if request.auth != null && (isAdmin() || isApproved(request.auth.uid));
      allow write: if false;
    }

    // Aprobaciones: las escribe solo el propietario; cada usuario puede leer la suya.
    match /access/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['ok', 'email', 'name', 'ts'])
        && request.resource.data.ok is bool;
      allow delete: if isAdmin();
    }
    // Solicitudes de acceso: cada usuario crea y ve la suya; el propietario las ve todas y las resuelve.
    match /requests/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['email', 'name', 'ts'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.ts is number
        && request.resource.data.ts > request.time.toMillis() - 300000
        && request.resource.data.ts <= request.time.toMillis() + 60000;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
    // Cada usuario aprobado solo accede a lo suyo; el resto está denegado por defecto.
    match /users/{uid}/stats/{tema} {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid)
        && request.resource.data.keys().hasOnly(['m', 'u'])
        && request.resource.data.u is number
        && request.resource.data.m is map
        && request.resource.data.m.size() <= 5000;
    }
    match /users/{uid}/sessions/{sessionId} {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid)
        && request.resource.data.keys().hasOnly(['id', 'ts', 'kind', 'n', 'a', 'f', 'b', 'secs', 'nota', 'temas', 'tipos', 'fails', 'titulo', 'porTiempo', 'interrupted', 'scorePending', 'scoringPolicy', 'milestoneEventId'])
        && request.resource.data.id is string
        && request.resource.data.ts is number
        && request.resource.data.kind in ['sim', 'rev', 'test']
        && request.resource.data.n is number && request.resource.data.a is number
        && request.resource.data.f is number && request.resource.data.b is number
        && request.resource.data.secs is number
        && request.resource.data.nota is number
        && request.resource.data.temas is map && request.resource.data.temas.size() <= 200
        && (!('porTiempo' in request.resource.data) || request.resource.data.porTiempo is bool)
        && (!('interrupted' in request.resource.data) || request.resource.data.interrupted is bool)
        && (!('scorePending' in request.resource.data) || request.resource.data.scorePending is bool)
        && (!('scoringPolicy' in request.resource.data) || (validScoringPolicy(request.resource.data.scoringPolicy) && (request.resource.data.scoringPolicy.wrongPenalty != null || request.resource.data.scorePending == true)))
        && (!('milestoneEventId' in request.resource.data) || (request.resource.data.milestoneEventId is string && request.resource.data.milestoneEventId.matches('^[A-Za-z0-9_.:-]{1,100}$')))
        && request.resource.data.tipos is map && request.resource.data.tipos.size() <= 100
        && request.resource.data.fails is list && request.resource.data.fails.size() <= 5000
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 500;
    }
    // Historial detallado de intentos: una proyección por pregunta y eventos inmutables.
    match /users/{uid}/attempts/{attemptId} {
      allow read: if canUse(uid);
      allow create: if canUse(uid)
        && validAttempt(attemptId)
        && (request.resource.data.state in ['unseen', 'pending'] || terminalEventIsValid(attemptId));
      // Reescribir un intento con los mismos datos no cambia nada: el cliente publica de forma idempotente, sin leer antes.
      allow update: if canUse(uid)
        && ((validAttempt(attemptId)
            && !('completedAt' in resource.data)
            && practiceAnswerIsLocked(attemptId))
          || request.resource.data == resource.data);
      allow delete: if canUse(uid);

      match /events/{eventId} {
        allow read: if canUse(uid);
        allow create: if canUse(uid)
          && exists(/databases/$(database)/documents/users/$(uid)/attempts/$(attemptId))
          && validAttemptEvent(eventId, attemptId);
        // Los eventos son inmutables; solo se admite reescribirlos idénticos (publicación idempotente).
        allow update: if canUse(uid) && request.resource.data == resource.data;
        allow delete: if canUse(uid);
      }
    }
    match /users/{uid}/attemptSessions/{sessionId} {
      allow read: if canUse(uid);
      allow create: if canUse(uid) && validAttemptSession(sessionId);
      allow update: if canUse(uid)
        && ((validAttemptSession(sessionId)
            && resource.data.status == 'active'
            && request.resource.data.lastSequence >= resource.data.lastSequence)
          || request.resource.data == resource.data);
      allow delete: if canUse(uid);
    }
    // El tombstone impide que una copia remota vieja resucite el detalle borrado.
    match /users/{uid}/cfg/attempts {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'deletedAt', 'revision'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.deletedAt is number
        && request.resource.data.revision is int && request.resource.data.revision >= 1;
      allow delete: if false;
    }
    // Temas vistos
    match /users/{uid}/cfg/seen {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid)
        && request.resource.data.keys().hasOnly(['t', 'ts'])
        && request.resource.data.t is list && request.resource.data.t.size() <= 200
        && request.resource.data.ts is number;
    }
    // Checkpoint e historial resumido de planificación; no contiene respuestas de preguntas.
    match /users/{uid}/cfg/training {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid) && validTrainingSession();
      allow delete: if false;
    }
    // Autoevaluaciones breves del temario en papel; separadas de los resultados objetivos.
    match /users/{uid}/cfg/trainingRecall {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'updatedAt', 'assessments'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt is number
        && request.resource.data.assessments is list
        && request.resource.data.assessments.size() <= 90;
      allow delete: if false;
    }
    // Actividades de repaso confirmadas por el usuario, separadas por cuenta.
    match /users/{uid}/cfg/trainingCalendar {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid) && validTrainingCalendar();
      allow delete: if false;
    }
    // Propuesta semanal separada para que clientes antiguos no reescriban un formato que no conocen.
    match /users/{uid}/cfg/weeklyStudyAgenda {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'updatedAt', 'agenda'])
        && request.resource.data.keys().hasAll(['schemaVersion', 'updatedAt', 'agenda'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt is number
        && validWeeklyStudyAgenda(request.resource.data.agenda);
      allow delete: if false;
    }
    // Selección explícita de archivos curriculares y eventos inmutables por apartado.
    match /users/{uid}/academyStudyMaterials/{topicId} {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid) && validAcademyMaterialSelection(topicId);
      allow delete: if false;
    }
    match /users/{uid}/academySectionEvents/{eventId} {
      allow read: if canUse(uid);
      allow create: if canUse(uid) && validAcademySectionEvent(eventId);
      allow update, delete: if false;
    }
    // Informes de errores del banco
    match /users/{uid}/cfg/cards {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid)
        && request.resource.data.keys().hasOnly(['m', 'u'])
        && request.resource.data.m is map
        && request.resource.data.u is number;
    }
    match /users/{uid}/cfg/reports {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid)
        && request.resource.data.keys().hasOnly(['m', 'u'])
        && request.resource.data.m is map
        && request.resource.data.u is number;
    }
  }
}
