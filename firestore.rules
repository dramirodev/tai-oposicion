rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Administrador: solo la cuenta de Google del propietario (correo verificado).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'dramiro@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isOwner(uid) { return isAdmin() && request.auth.uid == uid; }
    // Usuario aprobado por el propietario: existe access/{uid} con ok == true.
    function isApproved(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/access/$(uid))
        && get(/databases/$(database)/documents/access/$(uid)).data.ok == true;
    }
    // Pueden leer y escribir sus propios datos el propietario y los aprobados.
    function canUse(uid) { return isOwner(uid) || isApproved(uid); }

    // Banco de preguntas: lo leen el propietario y los aprobados; solo se escribe desde el script de publicación (IAM, no reglas).
    match /bank/{doc} {
      allow read: if request.auth != null && (isAdmin() || isApproved(request.auth.uid));
      allow write: if false;
    }

    // Aprobaciones: las escribe solo el propietario; cada usuario puede leer la suya.
    match /access/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['ok', 'email', 'name', 'ts'])
        && request.resource.data.ok is bool;
      allow delete: if isAdmin();
    }
    // Solicitudes de acceso: cada usuario crea y ve la suya; el propietario las ve todas y las resuelve.
    match /requests/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['email', 'name', 'ts'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.ts is number
        && request.resource.data.ts > request.time.toMillis() - 300000
        && request.resource.data.ts <= request.time.toMillis() + 60000;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
    // Cada usuario aprobado solo accede a lo suyo; el resto está denegado por defecto.
    match /users/{uid}/stats/{tema} {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid)
        && request.resource.data.keys().hasOnly(['m', 'u'])
        && request.resource.data.u is number
        && request.resource.data.m is map;
    }
    match /users/{uid}/sessions/{sessionId} {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid)
        && request.resource.data.keys().hasOnly(['id', 'ts', 'kind', 'n', 'a', 'f', 'b', 'secs', 'nota', 'temas', 'tipos', 'fails', 'titulo', 'porTiempo', 'interrupted'])
        && request.resource.data.id is string
        && request.resource.data.ts is number
        && request.resource.data.kind in ['sim', 'rev', 'test']
        && request.resource.data.n is number && request.resource.data.a is number
        && request.resource.data.f is number && request.resource.data.b is number
        && request.resource.data.secs is number
        && request.resource.data.nota is number
        && request.resource.data.temas is map
        && (!('porTiempo' in request.resource.data) || request.resource.data.porTiempo is bool)
        && (!('interrupted' in request.resource.data) || request.resource.data.interrupted is bool)
        && request.resource.data.tipos is map
        && request.resource.data.fails is list
        && request.resource.data.titulo is string;
    }
    // Temas vistos
    match /users/{uid}/cfg/seen {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid)
        && request.resource.data.keys().hasOnly(['t', 'ts'])
        && request.resource.data.t is list
        && request.resource.data.ts is number;
    }
    // Informes de errores del banco
    match /users/{uid}/cfg/cards {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid)
        && request.resource.data.keys().hasOnly(['m', 'u'])
        && request.resource.data.m is map
        && request.resource.data.u is number;
    }
    match /users/{uid}/cfg/reports {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid)
        && request.resource.data.keys().hasOnly(['m', 'u'])
        && request.resource.data.m is map
        && request.resource.data.u is number;
    }
  }
}
