{
  "name": "tai-pwa",
  "version": "1.1.22",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:offline-preview": "vite --config vite.offline-preview.config.mjs --host 127.0.0.1",
    "start": "npm run build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:firestore-rules": "npx --yes firebase-tools@13.35.1 emulators:exec --only firestore --project demo-tai-training-rules \"npx vitest run tests/firestore-rules.test.js\"",
    "test:e2e:firebase-auth": "npx --yes firebase-tools@13.35.1 emulators:exec --only auth,firestore --project demo-tai-auth \"TAI_AUTH_EMULATOR=1 TAI_FIREBASE_EMULATORS=1 npm run test:e2e -- tests/e2e/auth-emulator.spec.ts\"",
    "lint:ignore-growth": "node scripts/lint-ignore-growth.mjs",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "typecheck": "tsc -p .",
    "deploy": "npm run typecheck && npm test && npm run build && node scripts/validate_cards.mjs && npx --yes firebase-tools@13.35.1 deploy --only hosting,firestore:rules --project tai-oposicion",
    "publish:bank": "node scripts/publish_bank.mjs",
    "build:sample": "node scripts/build_sample.mjs",
    "audit:bank": "node scripts/audit-bank.mjs",
    "test:e2e": "playwright test",
    "test:e2e:question-audit": "playwright test --config=playwright.question-audit.config.ts",
    "test:e2e:code-audit": "playwright test --config=playwright.code-audit.config.ts",
    "test:e2e:ci": "node scripts/e2e-baseline.mjs",
    "measure:attempts": "node scripts/measure-attempt-volume.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm run lint && npm run lint:ignore-growth && npm run typecheck && npm test",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "test:e2e:supertest": "node scripts/e2e/run-supertest.mjs",
    "test:e2e:extreme": "playwright test --config=playwright.extreme.config.ts",
    "test:explorer:quick": "TAI_EXPLORER_PROFILE=fast TAI_EXPLORER_SCENARIOS=tests/e2e/missions/tai-profile-stress.yaml bash scripts/e2e/run-agentic-explorer.sh",
    "test:explorer:intensive": "TAI_EXPLORER_PROFILE=intensive TAI_EXPLORER_SCENARIOS=tests/e2e/missions/tai-profile-stress.yaml bash scripts/e2e/run-agentic-explorer.sh",
    "test:explorer:extreme": "TAI_EXPLORER_PROFILE=extreme TAI_EXPLORER_SCENARIOS=tests/e2e/missions/tai-profile-stress.yaml bash scripts/e2e/run-agentic-explorer.sh",
    "test:editorial": "python3 -m unittest discover -s tools/question-editorial -p \"test_*.py\"",
    "test:e2e:firefox": "playwright test --config=playwright.firefox.config.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "firebase": "^10.14.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "shiki": "^4.5.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "firebase-admin": "^13.10.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "^6.28.1",
    "@grpc/grpc-js": "^1.13.6"
  }
}
