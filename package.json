{
  "name": "tai-pwa",
  "version": "1.1.3",
  "private": true,
  "scripts": {
    "start": "npm run build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:ignore-growth": "node scripts/lint-ignore-growth.mjs",
    "typecheck": "tsc -p .",
    "deploy": "npm run typecheck && npm test && npm run build && node scripts/validate_cards.mjs && npx --yes firebase-tools@13.35.1 deploy --only hosting,firestore:rules --project tai-oposicion",
    "publish:bank": "node scripts/publish_bank.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node scripts/e2e-baseline.mjs",
    "measure:attempts": "node scripts/measure-attempt-volume.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm run lint && npm run lint:ignore-growth && npm run typecheck && npm test",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "shiki": "^4.5.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "^6.28.1",
    "@grpc/grpc-js": "^1.13.6"
  }
}
