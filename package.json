{
  "name": "tai-pwa",
  "version": "1.1.3",
  "private": true,
  "scripts": {
    "start": "npm run build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p .",
    "deploy": "npm run typecheck && npm test && npm run build && node scripts/validate_cards.mjs && npx --yes firebase-tools@13.35.1 deploy --only hosting,firestore:rules --project tai-oposicion",
    "publish:bank": "node scripts/publish_bank.mjs"
  },
  "dependencies": {
    "firebase": "^10.14.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "^6.28.1",
    "@grpc/grpc-js": "^1.13.6"
  }
}
