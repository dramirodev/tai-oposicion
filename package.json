{
  "name": "tai-pwa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "rm -rf public/app.js public/chunks && esbuild src/main.js --bundle --splitting --minify --format=esm --target=safari15 --outdir=public --entry-names=app --chunk-names=chunks/[name]-[hash]",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "firebase": "^10.14.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.9"
  }
}
